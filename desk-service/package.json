{
  "name": "carexps-desk-service",
  "version": "1.0.0",
  "private": true,
  "description": "Receives patient intake submissions from clinic tablets, renders a PDF, and files it into the OneDrive-synced folder.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "replay": "node src/server.js --replay-only",
    "build": "node build.mjs"
  },
  "dependencies": {
    "pdfkit": "^0.20.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
